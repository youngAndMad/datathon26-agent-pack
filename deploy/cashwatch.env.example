# cashwatch runtime configuration — copy to deploy/cashwatch.env (git-ignored? see note) and edit.
# Names follow cashwatch.settings.Settings (env prefix CASHWATCH_). Values are SAFE EXAMPLES.
# NEVER put the jury key here: it lives in the file named by CASHWATCH_API_KEY_FILE (mode 0600),
# generated with `bash deploy/gen_api_key.sh`. start.sh refuses env files with inline secrets.
#
# NOTE: deploy/cashwatch.env is not covered by .gitignore yet (request F-R1); do not commit it.

CASHWATCH_MODE=production            # production | test  (test is visibly labeled; never for judging)
CASHWATCH_BACKEND=mlx                # mlx | transformers | fake  (fake is refused in production)
CASHWATCH_HOST=127.0.0.1             # bind loopback; public traffic enters via Caddy (TLS)
CASHWATCH_PORT=8000
# CASHWATCH_DATA_DIR=/absolute/path/to/data        # default: <repo>/data (private, outside web root)
# CASHWATCH_API_KEY_FILE=/absolute/path/to/secrets/jury_api_key
# CASHWATCH_MODEL_PATH=/absolute/path/to/models/qwen3-vl-4b-instruct-mlx-8bit
# CASHWATCH_MODEL_MANIFEST=/absolute/path/to/models/manifest.json
# CASHWATCH_REGISTRY_PATH=/absolute/path/to/rules/registry.yaml
# CASHWATCH_PROFILE_PATH=/absolute/path/to/configs/runtime-profile.json
CASHWATCH_DEVICE=auto

# Engineering safety bounds (never below valid competition inputs)
CASHWATCH_MAX_FILE_BYTES=268435456   # 256 MiB
CASHWATCH_MAX_DURATION_SEC=300
CASHWATCH_MAX_UPLOAD_SEC=60
CASHWATCH_TOTAL_DEADLINE_SEC=300
CASHWATCH_INTERNAL_TERMINAL_SEC=270  # hard internal deadline from request start (D010)
CASHWATCH_ACTIVE_JOBS=1              # one active analysis per accelerator
CASHWATCH_MAX_QUEUE_LENGTH=1         # measured: real-clip max 102 s (n=42); queued job finishes < 270 s
CASHWATCH_RETENTION_HOURS=24         # only if organizer rules allow; never shorter than retrieval window
CASHWATCH_PREVIEW_ENABLED=true

# start.sh behaviour
CASHWATCH_START_TIMEOUT=240          # seconds to wait for /readyz (model load + warm-up)
