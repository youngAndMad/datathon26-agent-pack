{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datathon 26 job status response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "status"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "processing"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "status",
        "error"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "$ref": "jury-result.schema.json"
    }
  ]
}
