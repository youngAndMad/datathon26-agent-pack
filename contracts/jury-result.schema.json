{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "status",
    "verdict",
    "violations"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "done"
    },
    "verdict": {
      "enum": [
        "no_violation",
        "violation"
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Violation"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datathon 26 completed jury response",
  "description": "Exact organizer completion fields. Application validation must additionally verify finite in-range timestamps, actual JPEG bytes/provenance, anchor equality, supported observations and approved source references.",
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "no_violation"
          }
        }
      },
      "then": {
        "properties": {
          "violations": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "violations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "EvidenceFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "properties": {
        "timestamp_sec": {
          "type": "number",
          "minimum": 0
        },
        "image_base64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64",
          "contentMediaType": "image/jpeg",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "Violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "timecode_sec": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          }
        }
      }
    }
  }
}
